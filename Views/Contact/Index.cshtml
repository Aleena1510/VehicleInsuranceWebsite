@model InsurancePortal.Models.Contact

@{
    ViewData["Title"] = "Contact Us";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<style>
    body {
        background: #0b2c3d;
        color: white;
    }

    .contact-container {
        max-width: 1000px;
        margin: auto;
        margin-top: 50px;
        display: flex;
        flex-wrap: wrap;
        background: #0f3b50;
        border-radius: 15px;
        overflow: hidden;
    }

    .left {
        flex: 1;
        padding: 40px;
        background: #0c3a4d;
    }

    .right {
        flex: 1;
        padding: 40px;
        background: #f8f9fa;
        color: black;
    }

    input, textarea {
        margin-bottom: 15px;
    }

    .btn-custom {
        background: #0b2c3d;
        color: white;
        border-radius: 20px;
        width: 100%;
    }

</style>

<div class="contact-container">
    <!-- LEFT SIDE -->
    <div class="left">
        <h2>Contact Us</h2>
        <p>📧 example@email.com</p>
        <p>📞 +92 123 456 789</p>
        <p>📍 Street Address</p>
        <p>📍 For Feedback:VehicleInsurance@gmail.com</p>
        
        
    </div>

    <!-- RIGHT SIDE -->
    <div class="right">
        <form asp-action="Index" method="post">

            <input asp-for="Name" class="form-control" placeholder="Your Name" />
            <span asp-validation-for="Name" class="text-danger"></span>

            <input asp-for="Email" class="form-control" placeholder="Your Email" />
            <span asp-validation-for="Email" class="text-danger"></span>

            <input asp-for="Phone" class="form-control" placeholder="Phone Number" />
            <span asp-validation-for="Phone" class="text-danger"></span>

            <textarea asp-for="Message" class="form-control" placeholder="Your Message"></textarea>
            <span asp-validation-for="Message" class="text-danger"></span>

            <button type="submit" class="btn btn-custom">Send Message</button>
        </form>
    </div>
</div>


<!-- Bootstrap Modal Popup -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark-navy text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-success" id="successModalLabel">✅ Success!</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Your message has been sent successfully. We'll get back to you soon.
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

