@model List<InsurancePortal.Models.ViewModels.ReportViewModel>
@{
    ViewData["Title"] = "Monthly Sales Report";
    ViewBag.Icon = "fas fa-chart-line";
    Layout = "_AdminLayout.cshtml";

}

<div class="row mb-4">
    <div class="col">
        <h3><i class="fas fa-chart-line text-primary me-2"></i>Monthly Sales Report</h3>
        <p class="text-muted">Total Sales: $@Model.Sum(x => x.Value).ToString("N0") | Policies: @Model.Sum(x => x.Count)</p>
    </div>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Month</th>
                <th>Total Sales</th>
                <th>Policies Sold</th>
                <th>Avg Sale</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Title</strong></td>
                    <td><strong>$@item.Value.ToString("N0")</strong></td>
                    <td>@item.Count</td>
                    <td>$@(item.Value / item.Count).ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-4 text-end">
    <button class="btn btn-success"><i class="fas fa-download me-2"></i>Export PDF</button>
    <button class="btn btn-outline-primary ms-2"><i class="fas fa-print me-2"></i>Print</button>
</div>