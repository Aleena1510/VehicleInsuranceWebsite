@model List<Customer>
@{
    Layout = "_AdminLayout.cshtml";
}
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-users me-3"></i>All Customers (@Model.Count)</h2>
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
    </div>
</div>

<div class="row">
    @foreach (var customer in Model)
    {
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="mb-1">@customer.CustomerName</h5>
                        <small class="text-muted">@customer.CustomerAddress</small>
                    </div>
                    
                </div>
                <div class="mb-3">
                    <small class="text-muted">Phone:</small><br>
                    <strong>@customer.CustomerPhoneNumber</strong>
                </div>
                <div class="d-grid gap-2">
                    <a asp-action="CustomerDetails" asp-route-id="@customer.CustomerId"
                       class="btn btn-primary btn-sm">
                        <i class="fas fa-eye me-2"></i>View Details
                    </a>
                    <button type="button"
                            class="btn btn-danger btn-sm delete-customer"
                            data-id="@customer.CustomerId"
                            data-name="@customer.CustomerName">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    
        <script>
                document.addEventListener("DOMContentLoaded", function () {

                    document.querySelectorAll(".delete-customer").forEach(btn => {

                        btn.addEventListener("click", function () {

                            let id = this.getAttribute("data-id");
                            let name = this.getAttribute("data-name");

                            if (!confirm("Delete " + name + " ?")) return;

                            fetch("/Admin/DeleteCustomer?id=" + id, {
                                method: "POST"
                            })
                            .then(r => r.json())
                            .then(res => {
                                if (res.success) {
                                    alert("Deleted successfully");
                                    location.reload();
                                } else {
                                    alert("Delete failed");
                                }
                            })
                            .catch(err => {
                                console.log(err);
                                alert("Error occurred");
                            });

                        });

                    });

                });
        </script>
}


