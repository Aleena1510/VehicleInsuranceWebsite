@model List<ClaimDetail>
@{
    ViewData["Title"] = "Claims Report";
    ViewBag.Icon = "fas fa-file-alt";
    Layout = "_AdminLayout.cshtml";
   }

<h4>Claims Report</h4>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Claim #</th>
                <th>Policy #</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Insured</th>
                <th>Claimable</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ClaimNumber</td>
                    <td>@item.PolicyNumber</td>
                    <td>@item.CustomerName</td>
                    <td>@item.DateOfAccident</td>
                    <td>$@item.InsuredAmount</td>
                    <td>$@item.ClaimableAmount</td>
                </tr>
            }
        </tbody>
    </table>
</div>