<!-- Views/Admin/Dashboard.cshtml -->
@model InsurancePortal.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
   
  
}

<div class="row g-4 mb-5">
    <div class="col-lg-3 col-md-6">
        <div class="stat-card text-center">
            <i class="fas fa-users fs-1 text-info mb-3"></i>
            <h3 class="stat-number">@Model.TotalCustomers</h3>
            <p class="text-muted mb-0">Total Customers</p>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-card text-center">
            <i class="fas fa-car fs-1 text-success mb-3"></i>
            <h3 class="stat-number">@Model.TotalVehicles</h3>
            <p class="text-muted mb-0">Total Vehicles</p>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-card text-center">
            <i class="fas fa-file-contract fs-1 text-primary mb-3"></i>
            <h3 class="stat-number">@Model.TotalPolicies</h3>
            <p class="text-muted mb-0">Active Policies</p>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-card text-center">
            <i class="fas fa-dollar-sign fs-1 text-warning mb-3"></i>
            <h3 class="stat-number">$@Model.TotalBillings.ToString("N0")</h3>
            <p class="text-muted mb-0">Total Revenue</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="content-card">
            <h5 class="mb-3">Recent Customers</h5>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model.RecentCustomers)
                        {
                            <tr>
                                <td>@customer.CustomerId</td>
                                <td>@customer.CustomerName</td>
                                <td>@customer.CustomerPhoneNumber</td>
                                <td>@customer.CustomerAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="content-card">
            <h5 class="mb-3">Recent Policies</h5>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Policy #</th>
                            <th>Customer</th>
                            <th>Vehicle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var policy in Model.RecentPolicies)
                        {
                            <tr>
                                <td>@policy.PolicyNumber</td>
                                <td>@policy.CustomerName</td>
                                <td>@policy.VehicleName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>