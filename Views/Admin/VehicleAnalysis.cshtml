@model List<InsurancePortal.Models.ViewModels.ReportViewModel>
@{
    ViewData["Title"] = "Vehicle Wise Analysis";
    ViewBag.Icon = "fas fa-car-side";
    Layout = "_AdminLayout.cshtml";
   
}

<div class="row mb-4">
    <div class="col">
        <h3><i class="fas fa-car-side text-success me-2"></i>Vehicle Wise Analysis</h3>
        <p class="text-muted">Total Vehicles: @Model.Count | Total Rate: $@Model.Sum(x=>x.Value).ToString("N0")</p>
    </div>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Vehicle Name</th>
                <th>Policies</th>
                <th>Total Rate</th>
                <th>Avg Rate</th>
                <th>% Share</th>
            </tr>
        </thead>
        <tbody>
            @{
                var grandTotal = Model.Sum(x => x.Count);
                var grandValue = Model.Sum(x => x.Value);
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Title</strong></td>
                    <td>@item.Count</td>
                    <td>$@item.Value.ToString("N0")</td>
                    <td>$@(item.Value/item.Count).ToString("N0")</td>
                    <td>@(item.Count*100.0/grandTotal).ToString("F1")}%</td>
                </tr>
            }
            <tr class="table-dark">
                <td><strong>TOTAL</strong></td>
                <td><strong>@grandTotal</strong></td>
                <td><strong>$@grandValue.ToString("N0")</strong></td>
                <td>-</td>
                <td>100%</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="mt-4 text-end">
    <button class="btn btn-success"><i class="fas fa-download me-2"></i>Export PDF</button>
    <button class="btn btn-outline-primary ms-2"><i class="fas fa-print me-2"></i>Print</button>
</div>