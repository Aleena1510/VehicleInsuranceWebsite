@model List<CustomerBilling>
@{
    ViewData["Title"] = "Expenses";
    ViewBag.Icon = "fas fa-money-bill-wave";
     Layout = "_AdminLayout.cshtml";
    
}

<div class="d-flex justify-content-between mb-4">
    <h4>Total Expenses: $@Model.Sum(x => x.Amount).ToString("N0")</h4>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.BillNo</td>
                    <td>@item.Amount</td>
                    <td>$@item.Date</td>
                </tr>
            }
        </tbody>
    </table>
</div>