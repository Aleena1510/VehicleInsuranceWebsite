@{
    ViewData["Title"] = "Claim Submitted Successfully!";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 py-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-8">
            <!-- Success Animation -->
            <div class="success-animation mb-5">
                <div class="checkmark-circle mb-4">
                    <i class="fas fa-check-circle fa-5x text-success"></i>
                </div>
                <h1 class="display-3 fw-bold text-success mb-4">Claim Submitted!</h1>
                <p class="lead text-muted mb-5">Your claim has been registered successfully.</p>
            </div>

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white py-4">
                    <h3 class="mb-0"><i class="fas fa-clipboard-check me-2"></i>Next Steps</h3>
                </div>
                <div class="card-body p-5">
                    <div class="row g-4">
                        <div class="col-md-4 text-center">
                            <i class="fas fa-clock fa-3x text-primary mb-3"></i>
                            <h5>Processing</h5>
                            <p class="text-muted">Claim under review (24-48 hours)</p>
                        </div>
                        <div class="col-md-4 text-center">
                            <i class="fas fa-search fa-3x text-info mb-3"></i>
                            <h5>Investigation</h5>
                            <p class="text-muted">Surveyor will contact you</p>
                        </div>
                        <div class="col-md-4 text-center">
                            <i class="fas fa-money-bill-wave fa-3x text-success mb-3"></i>
                            <h5>Settlement</h5>
                            <p class="text-muted">Payment within 7 days</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-3 d-md-flex justify-content-center mt-5">
                
                
                <a href="/" class="btn btn-success btn-lg px-5 py-3">
                    <i class="fas fa-home me-2"></i>Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .checkmark-circle {
        width: 150px;
        height: 150px;
        border: 8px solid #d4edda;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
    }
</style>