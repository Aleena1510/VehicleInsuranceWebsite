@{
    ViewData["Title"] = "Confirmation";
    Layout = "~/Views/Shared/_AdmissionLayout.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var customer = ViewBag.CustomerData as InsurancePortal.Models.Customer;
    var vehicle = ViewBag.VehicleData as InsurancePortal.Models.Vehicle;
    var estimate = ViewBag.EstimateData as InsurancePortal.Models.Estimate;
    
}

<style>
    body {
        background: #0a1931;
    }

    .card-custom {
        background: #112240;
        color: white;
        border-radius: 15px;
    }

    .title {
        color: #64ffda;
    }

    .label {
        color: #8892b0;
    }

    .value {
        color: #ccd6f6;
        font-weight: 600;
    }

    .btn-custom {
        background: #64ffda;
        color: #0a1931;
        font-weight: bold;
    }

        .btn-custom:hover {
            background: #52e0c4;
        }
</style>

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="title">✔ Registration Complete</h1>
        <p class="text-light">Your insurance policy is successfully created</p>
    </div>

    <div class="card card-custom p-4 shadow-lg">

        <div class="row">

            <!-- Customer -->
            <div class="col-md-6">
                <h4 class="title">Customer Info</h4>

                <p>
                    <span class="label">Name:</span>
                    <span class="value">@customer?.CustomerName</span>
                </p>

                <p>
                    <span class="label">Phone:</span>
                    <span class="value">@customer?.CustomerPhoneNumber</span>
                </p>

                <p>
                    <span class="label">Address:</span>
                    <span class="value">@customer?.CustomerAddress</span>
                </p>
            </div>

            <!-- Policy -->
            <div class="col-md-6">
                <h4 class="title">Policy Info</h4>

                <p>
                    <span class="label">Policy No:</span>
                    <span class="value">
                        POL-@DateTime.Now.Year-@customer?.CustomerId
                    </span>
                </p>

                <p>
                    <span class="label">Vehicle:</span>
                    <span class="value">@vehicle?.VehicleModel</span>
                </p>

                <p>
                    <span class="label">PolicyType:</span>
                    <span class="value">@estimate?.VehiclePolicyType</span>
                </p>

                

                <p>
                    <span class="label">Status:</span>
                    <span class="value text-success">ACTIVE</span>
                </p>
            </div>

        </div>

        <hr class="bg-light" />

        <!-- Buttons -->
        <div class="text-center mt-4">
            <button onclick="printPage()" class="btn btn-custom px-4 me-2">
                Print / Save PDF
            </button>

            <a asp-action="Index" asp-controller="Home" class="btn btn-outline-light px-4">
                Back to Home
            </a>
        </div>

    </div>
</div>

<script>
    function printPage() {
        window.print();
    }
</script>

@* @model FormConfirmationReport.Models.ApplicationFormModel
@{
    ViewBag.Title = "Form Confirmation Report";
    Layout = null; // Self-contained page — no shared layout dependency
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Form Confirmation Report</title>
