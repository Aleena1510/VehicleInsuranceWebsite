<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Insurance Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/admission-style.css" rel="stylesheet" />
</head>
<body>
    <!-- Progress Bar -->
    <div class="progress-container sticky-top">
        <div class="progress-bar-container">
            <div class="progress-step active">
                <i class="fas fa-user"></i><span>Customer</span>
            </div>
            <div class="progress-step">
                <i class="fas fa-car"></i><span>Vehicle</span>
            </div>
            <div class="progress-step">
                <i class="fas fa-calculator"></i><span>Estimate</span>
            </div>
            <div class="progress-step">
                <i class="fas fa-file-contract"></i><span>Policy</span>
            </div>
            <div class="progress-step">
                <i class="fas fa-receipt"></i><span>Billing</span>
            </div>
            <div class="progress-step">
                <i class="fas fa-check-circle"></i><span>Complete</span>
            </div>
        </div>
    </div>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2024 Insurance Portal - All Rights Reserved | <i class="fas fa-shield-alt"></i> Secure & Trusted</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admission-script.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>