@model InsurancePortal.Models.CustomerBilling

@{
    ViewData["Title"] = "Step 5: Billing & Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var customer = ViewBag.CustomerData as InsurancePortal.Models.Customer;
    var vehicle = ViewBag.VehicleData as InsurancePortal.Models.Vehicle;
}
<link rel="stylesheet" href="~/css/Policypage.css" />


<div class="policy-page billing-page">

    <div class="policy-container">


        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="policy-header">

            <div class="policy-step-icon">
                <i class="fas fa-receipt"></i>
            </div>

            <div class="policy-step-number">
                STEP 05
            </div>

            <h1>
                Final Billing
            </h1>

            <p>
                Complete payment to activate your policy
            </p>

        </div>


        <!-- =====================================================
             PROGRESS
        ====================================================== -->

        <div class="policy-progress">

            <!-- Customer -->

            <div class="policy-progress-step completed">

                <div class="policy-progress-circle">
                    <i class="fas fa-user"></i>
                </div>

                <span>
                    Customer
                </span>

            </div>


            <div class="policy-progress-line completed-line"></div>


            <!-- Vehicle -->

            <div class="policy-progress-step completed">

                <div class="policy-progress-circle">
                    <i class="fas fa-car"></i>
                </div>

                <span>
                    Vehicle
                </span>

            </div>


            <div class="policy-progress-line completed-line"></div>


            <!-- Estimate -->

            <div class="policy-progress-step completed">

                <div class="policy-progress-circle">
                    <i class="fas fa-calculator"></i>
                </div>

                <span>
                    Estimate
                </span>

            </div>


            <div class="policy-progress-line completed-line"></div>


            <!-- Policy -->

            <div class="policy-progress-step completed">

                <div class="policy-progress-circle">
                    <i class="fas fa-file-contract"></i>
                </div>

                <span>
                    Policy
                </span>

            </div>


            <div class="policy-progress-line completed-line"></div>


            <!-- Billing -->

            <div class="policy-progress-step active">

                <div class="policy-progress-circle">
                    <i class="fas fa-receipt"></i>
                </div>

                <span>
                    Billing
                </span>

            </div>

        </div>


        <!-- =====================================================
             MAIN CARD
        ====================================================== -->

        <div class="policy-card billing-card">


            <!-- =================================================
                 CARD HEADER
            ================================================== -->

            <div class="policy-card-header">

                <div class="policy-card-icon">

                    <i class="fas fa-file-invoice-dollar"></i>

                </div>

                <div>

                    <h2>
                        Payment & Billing
                    </h2>

                    <p>
                        Review your billing details and complete registration
                    </p>

                </div>

            </div>


            <!-- =================================================
                 CARD BODY
            ================================================== -->

            <div class="policy-card-body">

                <form asp-action="Billing"
                      method="post"
                      enctype="multipart/form-data">


                    <!-- =================================================
                         VALIDATION
                    ================================================== -->

                    <div asp-validation-summary="All"
                         class="text-danger">
                    </div>


                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         style="display:none;">
                    </div>


                    <!-- =================================================
                         PAYMENT SUMMARY
                    ================================================== -->

                    <div class="policy-section">

                        <div class="policy-section-title">

                            <div class="policy-section-icon warranty">

                                <i class="fas fa-file-invoice-dollar"></i>

                            </div>

                            <div>

                                <h3>
                                    Payment Summary
                                </h3>

                                <p>
                                    Billing number and payment date
                                </p>

                            </div>

                        </div>


                        <div class="row g-4">


                            <!-- Bill Number -->

                            <div class="col-md-6">

                                <div class="policy-form-group">

                                    <label asp-for="BillNo">

                                        <span class="policy-label-icon gold">
                                            <i class="fas fa-hashtag"></i>
                                        </span>

                                        Bill Number

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="BillNo"
                                           class="policy-input policy-readonly"
                                           readonly
                                           value="@ViewBag.BillNumber" />


                                    <span asp-validation-for="BillNo"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Billing Date -->

                            <div class="col-md-6">

                                <div class="policy-form-group">

                                    <label asp-for="Date">

                                        <span class="policy-label-icon gold">
                                            <i class="fas fa-calendar-day"></i>
                                        </span>

                                        Billing Date

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="Date"
                                           type="date"
                                           class="policy-input"
                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           max="@DateTime.Now.ToString("yyyy-MM-dd")" />


                                    <span asp-validation-for="Date"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         VEHICLE & POLICY DETAILS
                    ================================================== -->

                    <div class="policy-section">

                        <div class="policy-section-title">

                            <div class="policy-section-icon vehicle">

                                <i class="fas fa-car"></i>

                            </div>

                            <div>

                                <h3>
                                    Vehicle & Policy Details
                                </h3>

                                <p>
                                    Customer and policy information
                                </p>

                            </div>

                        </div>


                        <div class="row g-4">


                            <!-- Customer Name -->

                            <div class="col-md-4">

                                <div class="policy-form-group">

                                    <label asp-for="CustomerName">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-user"></i>
                                        </span>

                                        Customer Name

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="CustomerName"
                                           class="policy-input policy-readonly"
                                           value="@customer?.CustomerName"
                                           readonly />


                                    <span asp-validation-for="CustomerName"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Policy Number -->

                            <div class="col-md-4">

                                <div class="policy-form-group">

                                    <label asp-for="PolicyNumber">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-file-contract"></i>
                                        </span>

                                        Policy Number

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="PolicyNumber"
                                           class="policy-input policy-readonly"
                                           readonly
                                           value="@ViewBag.PolicyNumber" />


                                    <span asp-validation-for="PolicyNumber"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Phone -->

                            <div class="col-md-4">

                                <div class="policy-form-group">

                                    <label asp-for="CustomerPhoneNumber">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-phone"></i>
                                        </span>

                                        Phone

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="CustomerPhoneNumber"
                                           class="policy-input policy-readonly"
                                           value="@customer?.CustomerPhoneNumber"
                                           readonly />


                                    <span asp-validation-for="CustomerPhoneNumber"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         AMOUNT DETAILS
                    ================================================== -->

                    <div class="policy-section">

                        <div class="policy-section-title">

                            <div class="policy-section-icon warranty">

                                <i class="fas fa-money-check-dollar"></i>

                            </div>

                            <div>

                                <h3>
                                    Amount Details
                                </h3>

                                <p>
                                    Vehicle information and final payment amount
                                </p>

                            </div>

                        </div>


                        <div class="row g-4">


                            <!-- Vehicle -->

                            <div class="col-md-4">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleName">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-car"></i>
                                        </span>

                                        Vehicle

                                    </label>


                                    <input asp-for="VehicleName"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleName"
                                           readonly />


                                    <span asp-validation-for="VehicleName"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Model -->

                            <div class="col-md-4">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleModel">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-car-side"></i>
                                        </span>

                                        Model

                                    </label>


                                    <input asp-for="VehicleModel"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleModel"
                                           readonly />


                                    <span asp-validation-for="VehicleModel"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Rate -->

                            <div class="col-md-4">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleRate">

                                        <span class="policy-label-icon gold">
                                            <i class="fas fa-rupee-sign"></i>
                                        </span>

                                        Rate

                                    </label>


                                    <input asp-for="VehicleRate"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleRate"
                                           readonly />


                                    <span asp-validation-for="VehicleRate"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Total Amount -->

                            <div class="col-md-12">

                                <div class="policy-form-group">

                                    <label asp-for="Amount">

                                        <span class="policy-label-icon gold">
                                            <i class="fas fa-money-bill-wave"></i>
                                        </span>

                                        Total Amount

                                    </label>


                                    <select asp-for="Amount"
                                            class="policy-select">

                                        <option value="">
                                            Select Amount
                                        </option>

                                        <option value="5000">
                                            $ 5,000
                                        </option>

                                        <option value="10000">
                                            $ 10,000
                                        </option>

                                        <option value="15000">
                                            $ 15,000
                                        </option>

                                        <option value="20000">
                                            $ 20,000
                                        </option>

                                    </select>


                                    <span asp-validation-for="Amount"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             CHASSIS / ENGINE
                        ================================================== -->

                        <div class="row g-4">


                            <!-- Chassis -->

                            <div class="col-md-6">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleBodyNumber">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-barcode"></i>
                                        </span>

                                        Chassis No.

                                    </label>


                                    <input asp-for="VehicleBodyNumber"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleBodyNumber"
                                           readonly />


                                    <span asp-validation-for="VehicleBodyNumber"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Engine -->

                            <div class="col-md-6">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleEngineNumber">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-cogs"></i>
                                        </span>

                                        Engine No.

                                    </label>


                                    <input asp-for="VehicleEngineNumber"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleEngineNumber"
                                           readonly />


                                    <span asp-validation-for="VehicleEngineNumber"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         PAYMENT RECEIPT
                    ================================================== -->

                    <div class="policy-section">

                        <div class="policy-section-title">

                            <div class="policy-section-icon">

                                <i class="fas fa-cloud-upload-alt"></i>

                            </div>

                            <div>

                                <h3>
                                    Payment Receipt / Proof
                                </h3>

                                <p>
                                    Upload your payment receipt or proof
                                </p>

                            </div>

                        </div>


                        <div class="policy-form-group">

                            <label asp-for="ProofFile">

                                <span class="policy-label-icon">
                                    <i class="fas fa-file-upload"></i>
                                </span>

                                Payment Receipt / Proof

                            </label>


                            <input type="file"
                                   asp-for="ProofFile" />


                            <span asp-validation-for="ProofFile"
                                  class="text-danger">
                            </span>


                            <div class="form-text">
                                Upload a valid payment receipt or proof document.
                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         ACTION BUTTONS
                    ================================================== -->

                    <div class="policy-actions">


                        <!-- Back -->

                        <a asp-action="Policy"
                           class="policy-btn policy-previous">

                            <i class="fas fa-arrow-left"></i>

                            <span>
                                Edit Policy
                            </span>

                        </a>


                        <!-- Complete -->

                        <button type="submit"
                                class="policy-btn policy-next">

                            <span>
                                Complete Registration
                            </span>

                            <i class="fas fa-check-double"></i>

                        </button>


                    </div>


                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}