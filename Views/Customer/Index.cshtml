@model InsurancePortal.Models.Customer
@{
    ViewData["Title"] = "Step 1: Customer Information";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h2 class="mb-0">
                        <i class="fas fa-user-plus me-3"></i>
                        Step 1: Customer Registration
                    </h2>

                    @if (TempData["msg"] != null)
                    {
                        <div class="alert alert-success">@TempData["msg"]</div>
                    }

                    <small class="text-white-50">Enter customer personal details</small>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Index" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="CustomerName" class="form-label fw-bold">
                                    <i class="fas fa-user text-primary me-2"></i>Full Name *
                                </label>
                                <input asp-for="CustomerName" class="form-control form-control-lg" placeholder="Enter full name" />
                                <span asp-validation-for="CustomerName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="CustomerAddress" class="form-label fw-bold">
                                    <i class="fas fa-map-marker-alt text-primary me-2"></i>Address *
                                </label>
                                <textarea asp-for="CustomerAddress" class="form-control form-control-lg" rows="3" placeholder="Enter complete address"></textarea>
                                <span asp-validation-for="CustomerAddress" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="CustomerPhoneNumber" class="form-label fw-bold">
                                    <i class="fas fa-phone text-primary me-2"></i>Phone Number *
                                </label>
                                <input asp-for="CustomerPhoneNumber" class="form-control form-control-lg" placeholder="Enter phone number" />
                                <span asp-validation-for="CustomerPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-3 d-md-flex justify-content-between mt-5">
                            <button type="button" class="btn btn-secondary btn-lg px-5" onclick="history.back()">
                                <i class="fas fa-arrow-left me-2"></i>Back
                            </button>
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="fas fa-arrow-right me-2"></i>Next: Vehicle Info
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}