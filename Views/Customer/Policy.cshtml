@model InsurancePortal.Models.CustomerPolicy

@{
    ViewData["Title"] = "Step 4: Policy Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var customer = ViewBag.CustomerData as InsurancePortal.Models.Customer;
    var vehicle = ViewBag.VehicleData as InsurancePortal.Models.Vehicle;
    var estimate = ViewBag.EstimateData as InsurancePortal.Models.Estimate;
}
<link rel="stylesheet" href="~/css/Policypage.css" />

<div class="policy-page">

    <div class="policy-container">

        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="policy-header">

            <div class="policy-step-icon">
                <i class="fas fa-file-contract"></i>
            </div>

            <div class="policy-step-number">
                STEP 04
            </div>

            <h1>
                Policy Creation
            </h1>

            <p>
                Finalize your insurance policy details
            </p>

        </div>


        <!-- =====================================================
             PROGRESS
        ====================================================== -->

        <div class="policy-progress">

            <div class="policy-progress-step completed">

                <div class="policy-progress-circle">
                    <i class="fas fa-user"></i>
                </div>

                <span>Customer</span>

            </div>


            <div class="policy-progress-line completed-line"></div>


            <div class="policy-progress-step completed">

                <div class="policy-progress-circle">
                    <i class="fas fa-car"></i>
                </div>

                <span>Vehicle</span>

            </div>


            <div class="policy-progress-line completed-line"></div>


            <div class="policy-progress-step completed">

                <div class="policy-progress-circle">
                    <i class="fas fa-calculator"></i>
                </div>

                <span>Estimate</span>

            </div>


            <div class="policy-progress-line completed-line"></div>


            <div class="policy-progress-step active">

                <div class="policy-progress-circle">
                    <i class="fas fa-file-contract"></i>
                </div>

                <span>Policy</span>

            </div>


            <div class="policy-progress-line"></div>


            <div class="policy-progress-step">

                <div class="policy-progress-circle">
                    <i class="fas fa-credit-card"></i>
                </div>

                <span>Billing</span>

            </div>

        </div>


        <!-- =====================================================
             MAIN CARD
        ====================================================== -->

        <div class="policy-card">


            <!-- =================================================
                 CARD HEADER
            ================================================== -->

            <div class="policy-card-header">

                <div class="policy-card-icon">
                    <i class="fas fa-file-signature"></i>
                </div>

                <div>

                    <h2>
                        Insurance Policy
                    </h2>

                    <p>
                        Review and finalize policy information
                    </p>

                </div>

            </div>


            <!-- =================================================
                 CARD BODY
            ================================================== -->

            <div class="policy-card-body">

                <form asp-action="Policy"
                      method="post"
                      enctype="multipart/form-data">

                    <!-- Validation -->

                    <div asp-validation-summary="All"
                         class="policy-validation">
                    </div>


                    <div asp-validation-summary="ModelOnly"
                         class="policy-validation"
                         style="display:none;">
                    </div>


                    <!-- =================================================
                         POLICY INFORMATION
                    ================================================== -->

                    <div class="policy-section">

                        <div class="policy-section-title">

                            <div class="policy-section-icon">
                                <i class="fas fa-info-circle"></i>
                            </div>

                            <div>

                                <h3>
                                    Policy Information
                                </h3>

                                <p>
                                    Basic insurance policy details
                                </p>

                            </div>

                        </div>


                        <div class="row g-4">


                            <!-- Policy Number -->

                            <div class="col-md-4">

                                <div class="policy-form-group">

                                    <label asp-for="PolicyNumber">

                                        <span class="policy-label-icon gold">
                                            <i class="fas fa-hashtag"></i>
                                        </span>

                                        Policy Number

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="PolicyNumber"
                                           class="policy-input policy-readonly"
                                           readonly
                                           value="@ViewBag.PolicyNumber" />


                                    <span asp-validation-for="PolicyNumber"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Policy Date -->

                            <div class="col-md-4">

                                <div class="policy-form-group">

                                    <label asp-for="PolicyDate">

                                        <span class="policy-label-icon gold">
                                            <i class="fas fa-calendar"></i>
                                        </span>

                                        Issue Date

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="PolicyDate"
                                           type="date"
                                           class="policy-input"
                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           max="@DateTime.Now.ToString("yyyy-MM-dd")" />


                                    <span asp-validation-for="PolicyDate"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Policy Duration -->

                            <div class="col-md-4">

                                <div class="policy-form-group">

                                    <label asp-for="PolicyDuration">

                                        <span class="policy-label-icon gold">
                                            <i class="fas fa-clock"></i>
                                        </span>

                                        Duration (Year)

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <div class="policy-input-wrapper">

                                        <select asp-for="PolicyDuration"
                                                class="policy-select">

                                            <option value="">
                                                Policy Duration
                                            </option>

                                            <option value="1">
                                                1 Year
                                            </option>

                                            <option value="2">
                                                5 Year
                                            </option>

                                            <option value="3">
                                                7 Year
                                            </option>

                                        </select>

                                    </div>


                                    <span asp-validation-for="PolicyDuration"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         CUSTOMER INFORMATION
                    ================================================== -->

                    <div class="policy-section">

                        <div class="policy-section-title">

                            <div class="policy-section-icon">
                                <i class="fas fa-user"></i>
                            </div>

                            <div>

                                <h3>
                                    Customer Information
                                </h3>

                                <p>
                                    Customer details associated with this policy
                                </p>

                            </div>

                        </div>


                        <!-- Full Name -->

                        <div class="policy-form-group">

                            <label asp-for="CustomerName">

                                <span class="policy-label-icon">
                                    <i class="fas fa-user"></i>
                                </span>

                                Full Name

                                <span class="policy-required">
                                    *
                                </span>

                            </label>


                            <input asp-for="CustomerName"
                                   class="policy-input policy-readonly"
                                   placeholder="Customer full name"
                                   value="@customer?.CustomerName"
                                   readonly />


                            <span asp-validation-for="CustomerName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Address -->

                        <div class="policy-form-group">

                            <label asp-for="CustomerAddress">

                                <span class="policy-label-icon">
                                    <i class="fas fa-map-marker-alt"></i>
                                </span>

                                Address

                                <span class="policy-required">
                                    *
                                </span>

                            </label>


                            <input asp-for="CustomerAddress"
                                   class="policy-input policy-readonly"
                                   placeholder="Customer address"
                                   value="@customer?.CustomerAddress"
                                   readonly />


                            <span asp-validation-for="CustomerAddress"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Phone -->

                        <div class="policy-form-group">

                            <label asp-for="CustomerPhoneNumber">

                                <span class="policy-label-icon">
                                    <i class="fas fa-phone"></i>
                                </span>

                                Phone Number

                                <span class="policy-required">
                                    *
                                </span>

                            </label>


                            <input asp-for="CustomerPhoneNumber"
                                   class="policy-input policy-readonly"
                                   placeholder="Customer phone number"
                                   value="@customer?.CustomerPhoneNumber"
                                   readonly />


                            <span asp-validation-for="CustomerPhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- =================================================
                         VEHICLE INFORMATION
                    ================================================== -->

                    <div class="policy-section">

                        <div class="policy-section-title">

                            <div class="policy-section-icon vehicle">
                                <i class="fas fa-car-side"></i>
                            </div>

                            <div>

                                <h3>
                                    Vehicle Specifications
                                </h3>

                                <p>
                                    Vehicle information linked with the policy
                                </p>

                            </div>

                        </div>


                        <div class="row g-4">


                            <!-- Vehicle Name -->

                            <div class="col-md-3">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleName">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-car"></i>
                                        </span>

                                        Vehicle Name

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="VehicleName"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleName"
                                           readonly />


                                    <span asp-validation-for="VehicleName"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Vehicle Model -->

                            <div class="col-md-3">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleModel">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-car-side"></i>
                                        </span>

                                        Model

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="VehicleModel"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleModel"
                                           readonly />


                                    <span asp-validation-for="VehicleModel"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Vehicle Version -->

                            <div class="col-md-3">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleVersion">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-layer-group"></i>
                                        </span>

                                        Version

                                    </label>


                                    <input asp-for="VehicleVersion"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleVersion"
                                           readonly />


                                    <span asp-validation-for="VehicleVersion"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Registration Number -->

                            <div class="col-md-3">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleNumber">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-id-card"></i>
                                        </span>

                                        Reg. No.

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="VehicleNumber"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleNumber"
                                           readonly />


                                    <span asp-validation-for="VehicleNumber"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         PREMIUM / WARRANTY
                    ================================================== -->

                    <div class="policy-section">

                        <div class="policy-section-title">

                            <div class="policy-section-icon warranty">
                                <i class="fas fa-shield-alt"></i>
                            </div>

                            <div>

                                <h3>
                                    Premium & Warranty
                                </h3>

                                <p>
                                    Financial and protection details
                                </p>

                            </div>

                        </div>


                        <div class="row g-4">


                            <!-- Premium -->

                            <div class="col-md-4">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleRate">

                                        <span class="policy-label-icon gold">
                                            <i class="fas fa-rupee-sign"></i>
                                        </span>

                                        Premium Amount

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="VehicleRate"
                                           type="number"
                                           step="0.01"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleRate"
                                           readonly />


                                    <span asp-validation-for="VehicleRate"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Warranty -->

                            <div class="col-md-4">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleWarranty">

                                        <span class="policy-label-icon gold">
                                            <i class="fas fa-shield-alt"></i>
                                        </span>

                                        Warranty

                                    </label>


                                    <input asp-for="VehicleWarranty"
                                           class="policy-input policy-readonly"
                                           value="@estimate?.VehicleWarranty"
                                           readonly />


                                    <span asp-validation-for="VehicleWarranty"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Body Number -->

                            <div class="col-md-2">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleBodyNumber">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-barcode"></i>
                                        </span>

                                        Body No.

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="VehicleBodyNumber"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleBodyNumber"
                                           readonly />


                                    <span asp-validation-for="VehicleBodyNumber"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Engine Number -->

                            <div class="col-md-2">

                                <div class="policy-form-group">

                                    <label asp-for="VehicleEngineNumber">

                                        <span class="policy-label-icon">
                                            <i class="fas fa-cogs"></i>
                                        </span>

                                        Engine No.

                                        <span class="policy-required">
                                            *
                                        </span>

                                    </label>


                                    <input asp-for="VehicleEngineNumber"
                                           class="policy-input policy-readonly"
                                           value="@vehicle?.VehicleEngineNumber"
                                           readonly />


                                    <span asp-validation-for="VehicleEngineNumber"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         ADDRESS PROOF
                    ================================================== -->

                    <div class="policy-section">

                        <div class="policy-section-title">

                            <div class="policy-section-icon">
                                <i class="fas fa-file-upload"></i>
                            </div>

                            <div>

                                <h3>
                                    Address Proof
                                </h3>

                                <p>
                                    Upload a valid customer address document
                                </p>

                            </div>

                        </div>


                        <div class="policy-form-group">

                            <label asp-for="CustomerAddProveFile">

                                <span class="policy-label-icon">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                </span>

                                Address Proof Document

                            </label>


                            <input asp-for="CustomerAddProveFile"
                                   type="file" />


                            <span asp-validation-for="CustomerAddProveFile"
                                  class="text-danger">
                            </span>


                            <div class="form-text">
                                Passport, Voter ID, etc.
                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         ACTIONS
                    ================================================== -->

                    <div class="policy-actions">

                        <a asp-action="Estimate"
                           class="policy-btn policy-previous">

                            <i class="fas fa-arrow-left"></i>

                            <span>
                                Previous Step
                            </span>

                        </a>


                        <button type="submit"
                                class="policy-btn policy-next">

                            <span>
                                Proceed to Billing
                            </span>

                            <i class="fas fa-credit-card"></i>

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}