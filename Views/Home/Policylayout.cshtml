@model InsurancePortal.Models.CustomerBilling

@{
    ViewData["Title"] = "Terms & Conditions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <link href="~/css/Policylayout.css" rel="stylesheet" />
</head>

<div class="terms-page">

    <div class="container">

        <!-- ================= HERO ================= -->

        <div class="terms-hero">

            <div class="hero-icon">
                <i class="fas fa-shield-alt"></i>
            </div>

            <h1>Terms & Conditions</h1>

            <p>
                Please review the following terms carefully before proceeding
                with your vehicle insurance.
            </p>

        </div>


        <!-- ================= TERMS CARD ================= -->

        <div class="terms-card">

            <!-- Header -->

            <div class="terms-header">

                <h2>
                    <i class="fas fa-file-contract me-2"></i>
                    Important Terms & Conditions
                </h2>

                <p>
                    <i class="fas fa-circle-exclamation me-1"></i>
                    Please read and understand all conditions before continuing.
                </p>

            </div>


            <!-- Body -->

            <div class="terms-body">

                <div class="row g-4">


                    <!-- Form Accuracy -->

                    <div class="col-md-6">

                        <div class="term-box">

                            <div class="term-icon">
                                <i class="fas fa-clipboard-check"></i>
                            </div>

                            <h5>Form Accuracy</h5>

                            <ul>

                                <li>
                                    <strong>Fill all details carefully</strong>.
                                    Incorrect information may result in
                                    <span class="danger-text">
                                        policy cancellation
                                    </span>.
                                </li>

                                <li>
                                    Vehicle details such as
                                    <strong>Chassis Number</strong> and
                                    <strong>Engine Number</strong>
                                    must match the RC book.
                                </li>

                                <li>
                                    Customer information must match the
                                    registered <strong>CNIC / Passport</strong>.
                                </li>

                            </ul>

                        </div>

                    </div>


                    <!-- Claim Process -->

                    <div class="col-md-6">

                        <div class="term-box">

                            <div class="term-icon rose">
                                <i class="fas fa-gavel"></i>
                            </div>

                            <h5>Claim Process</h5>

                            <ul>

                                <li>
                                    The <strong>Policy Number</strong>
                                    must match exactly during claim filing.
                                </li>

                                <li>
                                    Billing receipt must be
                                    <strong>clear and readable</strong>.
                                </li>

                                <li>
                                    Any tampering or alteration of documents
                                    may result in
                                    <span class="danger-text">
                                        claim rejection
                                    </span>.
                                </li>

                            </ul>

                        </div>

                    </div>


                    <!-- Payment Terms -->

                    <div class="col-md-6">

                        <div class="term-box">

                            <div class="term-icon gold">
                                <i class="fas fa-credit-card"></i>
                            </div>

                            <h5>Payment Terms</h5>

                            <ul>

                                <li>
                                    Payment proof must be uploaded in
                                    <strong>Image or PDF</strong> format.
                                </li>

                                <li>
                                    Premium must be paid before
                                    <strong>policy activation</strong>.
                                </li>

                                <li>
                                    Policy becomes valid only after
                                    <strong>payment confirmation</strong>.
                                </li>

                            </ul>

                        </div>

                    </div>


                    <!-- Policy Validity -->

                    <div class="col-md-6">

                        <div class="term-box">

                            <div class="term-icon emerald">
                                <i class="fas fa-calendar-check"></i>
                            </div>

                            <h5>Policy Validity</h5>

                            <ul>

                                <li>
                                    Policy starts from the
                                    <strong>billing date</strong>.
                                </li>

                                <li>
                                    Coverage remains valid for
                                    <strong>one year</strong>
                                    from the activation date.
                                </li>

                                <li>
                                    A renewal reminder may be sent
                                    <strong>30 days before expiry</strong>.
                                </li>

                            </ul>

                        </div>

                    </div>

                </div>


                <!-- ================= AGREEMENT ================= -->

                <div class="agreement-box">

                    <input class="agreement-checkbox"
                           type="checkbox"
                           id="termsAgreement"
                           required />

                    <div class="agreement-content">

                        <label for="termsAgreement">

                            <i class="fas fa-circle-check me-2"></i>

                            I have read and agree to all the
                            <strong>Terms & Conditions</strong>.

                        </label>

                        <span class="agreement-note">

                            <i class="fas fa-info-circle me-1"></i>

                            You must accept these terms before proceeding
                            with the insurance application.

                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= ACTION BUTTONS ================= -->

        <div class="terms-actions pb-5">

            <a asp-action="Index"
               class="terms-btn btn-back">

                <i class="fas fa-arrow-left me-2"></i>

                Back to Home

            </a>


            <a asp-action="Index"
               asp-controller="Customer"
               id="getStartedBtn"
               class="terms-btn btn-start">

                Continue to Application

                <i class="fas fa-arrow-right ms-2"></i>

            </a>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document
            .getElementById("getStartedBtn")
            .addEventListener("click", function(e) {

                const agreement =
                    document.getElementById("termsAgreement");

                if (!agreement.checked) {

                    e.preventDefault();

                    alert(
                        "⚠️ Please agree to the Terms & Conditions before continuing."
                    );

                    agreement.focus();
                }

            });

    </script>

}